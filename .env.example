# Redis (local default: 127.0.0.1:6379)
REDIS_ADDR=127.0.0.1:6379
# REDIS_TLS=true
# REDIS_PASSWORD=
# REDIS_DB=0

# Session document TTL in Redis (days)
# SESSION_TTL_DAYS=30

# HTTP listen address (default :8080). If unset and PORT is set (e.g. Render), uses 0.0.0.0:PORT.
# LISTEN_ADDR=:8080

# Comma-separated browser origins allowed to call the API (omit or empty = Access-Control-Allow-Origin: *).
# Production example:
# CORS_ALLOWED_ORIGINS=https://keep-swinging.netlify.app
# Optional: add http://localhost:3000 if you serve the static UI locally while hitting this API.
